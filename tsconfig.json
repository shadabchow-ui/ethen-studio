{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@ethen/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@ethen/ui/*": [
        "./packages/ui/src/*"
      ],
      "@ethen/app-shell": [
        "./packages/app-shell/src/index.ts"
      ],
      "@ethen/app-shell/*": [
        "./packages/app-shell/src/*"
      ],
      "@ethen/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@ethen/contracts/*": [
        "./packages/contracts/src/*"
      ],
      "@ethen/config": [
        "./packages/config/src/index.ts"
      ],
      "@ethen/config/*": [
        "./packages/config/src/*"
      ],
      "@ethen/auth": [
        "./packages/auth/src/index.ts"
      ],
      "@ethen/auth/*": [
        "./packages/auth/src/*"
      ],
      "@ethen/account": [
        "./packages/account/src/index.ts"
      ],
      "@ethen/account/*": [
        "./packages/account/src/*"
      ],
      "@ethen/billing": [
        "./packages/billing/src/index.ts"
      ],
      "@ethen/billing/*": [
        "./packages/billing/src/*"
      ],
      "@ethen/usage": [
        "./packages/usage/src/index.ts"
      ],
      "@ethen/usage/*": [
        "./packages/usage/src/*"
      ],
      "@ethen/navigation": [
        "./packages/navigation/src/index.ts"
      ],
      "@ethen/navigation/*": [
        "./packages/navigation/src/*"
      ],
      "@ethen/security": [
        "./packages/security/src/index.ts"
      ],
      "@ethen/security/*": [
        "./packages/security/src/*"
      ],
      "@ethen/database": [
        "./packages/database/src/index.ts"
      ],
      "@ethen/database/*": [
        "./packages/database/src/*"
      ],
      "@ethen/studio-core": [
        "./packages/studio/src/index.ts"
      ],
      "@ethen/studio-core/*": [
        "./packages/studio/src/*"
      ],
      "@ethen/ai": [
        "./packages/ai/src/index.ts"
      ],
      "@ethen/ai/*": [
        "./packages/ai/src/*"
      ],
      "@ethen/tools": [
        "./packages/tools/src/index.ts"
      ],
      "@ethen/tools/*": [
        "./packages/tools/src/*"
      ],
      "@ethen/models": [
        "./packages/models/src/index.ts"
      ],
      "@ethen/models/*": [
        "./packages/models/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "packages/*/node_modules"
  ]
}
