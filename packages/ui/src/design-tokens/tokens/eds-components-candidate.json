{
  "schemaVersion": 1,
  "name": "Ethen Candidate Component Bindings",
  "status": "CANDIDATE",
  "originMilestone": "D06",
  "principle": "Components reference eds.cmp.* only; cmp references eds.sys.* only; sys references an approved eds.* token only. A component touching raw is a build error.",
  "sys": {
    "action.brand": {
      "ref": "eds-lapis",
      "role": "brand action surface"
    },
    "action.brand-strong": {
      "ref": "eds-lapis-strong",
      "role": "brand hover, focus ring"
    },
    "action.brand-wash": {
      "ref": "eds-lapis-wash",
      "role": "selected wash, hover tint"
    },
    "action.ink": {
      "ref": "eds-ink",
      "role": "ink primary action surface"
    },
    "action.on-ink": {
      "ref": "eds-canvas",
      "role": "text on ink surfaces in both themes"
    },
    "action.on-brand": {
      "ref": "eds-canvas",
      "role": "text on brand surfaces in both themes"
    },
    "control.bg": {
      "ref": "eds-card",
      "role": "control and menu surfaces"
    },
    "control.bg-raised": {
      "ref": "eds-elevated",
      "role": "raised control surfaces, toast"
    },
    "control.bg-sunken": {
      "ref": "eds-paper",
      "role": "disabled and sunken surfaces, kbd"
    },
    "control.border": {
      "ref": "eds-rule-control",
      "role": "every interactive boundary, >=3:1"
    },
    "control.border-subtle": {
      "ref": "eds-rule",
      "role": "non-interactive container borders"
    },
    "control.border-hair": {
      "ref": "eds-rule-hair",
      "role": "hairline dividers, chip borders"
    },
    "control.text": {
      "ref": "eds-ink",
      "role": "control text"
    },
    "control.text-secondary": {
      "ref": "eds-text-secondary",
      "role": "labels, inactive tabs, kbd"
    },
    "control.placeholder": {
      "ref": "eds-text-tertiary",
      "role": "placeholder and hint text"
    },
    "control.error": {
      "ref": "eds-brick",
      "role": "error borders and text"
    },
    "status.attention": {
      "ref": "eds-ochre",
      "role": "pending, caution"
    },
    "status.danger": {
      "ref": "eds-brick",
      "role": "destructive, failed"
    },
    "status.info": {
      "ref": "eds-lapis",
      "role": "informational"
    },
    "status.neutral": {
      "ref": "eds-slate",
      "role": "reference, neutral system"
    },
    "status.verified": {
      "ref": "eds-ink",
      "role": "success is ink plus glyph, never green"
    },
    "table.header-text": {
      "ref": "eds-text-tertiary",
      "role": "table headers, timestamps"
    },
    "table.row-border": {
      "ref": "eds-rule-hair",
      "role": "row separators"
    }
  },
