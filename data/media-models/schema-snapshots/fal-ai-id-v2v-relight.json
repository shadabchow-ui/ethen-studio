      "image_url"
    ],
    "type": "object",
    "properties": {
      "seed": {
        "description": "Random seed for reproducibility. The same seed is used for every clip of a multi-clip generation.",
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "resolution": {
        "description": "Output resolution tier. Orientation follows the source video (720p is 1280x720 or 720x1280; 480p is 832x480 or 480x832).",
        "enum": [
          "480p",
          "720p"
        ],
        "type": "string",
        "default": "720p"
      },
      "num_inference_steps": {
        "description": "Number of diffusion sampling steps per clip. Higher improves quality but is slower.",
        "maximum": 40,
        "type": "integer",
        "default": 30,
        "minimum": 2
      },
      "video_url": {
        "description": "URL of the source video whose motion and framing drive the generation.",
        "type": "string",
        "examples": [
          "https://storage.googleapis.com/falserverless/model_tests/video_models/mmaudio_input.mp4"
        ]
      },
      "num_frames": {
        "description": "Maximum number of output frames. Capped at the source video's frame count.",
        "maximum": 241,
        "type": "integer",
        "default": 81,
        "minimum": 17
      },
      "keyframes": {
        "description": "Optional restyled keyframes pinned at specific output frame indices to anchor identity over long videos.",
        "items": {
          "$refName": "Keyframe",
          "required": [
            "image_url",
            "frame_index"
          ],
          "type": "object",
          "properties": {
            "frame_index": {
              "description": "0-based output frame index for this keyframe. Must be >= 1 (frame 0 is the restyled first frame from `image_url`) and less than the output frame count.",
              "type": "integer",
              "minimum": 1,
              "examples": [
                80
              ]
            },
            "image_url": {
              "description": "URL of a restyled keyframe image. It is pinned verbatim at `frame_index` to anchor identity over long videos. Its aspect ratio must match the output aspect ratio within 0.1.",
              "type": "string",
              "examples": [
                "https://storage.googleapis.com/falserverless/example_inputs/ltxv-image-input.jpg"
              ]
            }
          }
        },
        "type": "array",
        "maxItems": 5
      },
      "vace_scale": {
        "description": "VACE conditioning scale. Controls how strongly the source video's structure constrains the generation.",
        "maximum": 2,
        "type": "number",
        "default": 1,
        "minimum": 0
      },
      "image_url": {
        "description": "URL of the restyled first frame. The video is regenerated in this frame's identity/style.",
        "type": "string",
        "examples": [
          "https://storage.googleapis.com/falserverless/example_inputs/ltxv-image-input.jpg"
        ]
      },
      "enable_safety_checker": {
        "description": "Enable safety checking of inputs and outputs.",
        "type": "boolean",
        "default": true
      },
      "guidance_scale": {
        "description": "Classifier-free guidance scale. Controls prompt adherence versus creativity.",
        "maximum": 10,
        "type": "number",
        "default": 5,
        "minimum": 1
      },
      "prompt": {
        "description": "The prompt describing the restyled video to generate.",
        "type": "string",
        "examples": [
          "An astronaut walking through an autumn forest"
        ]
      }
    }
