        "type": "string",
        "description": "URL of the product image to be processed."
      },
      "shadow": {
        "$refName": "Shadow",
        "type": "object",
        "description": "Shadow: choose a type ('Generative'/'Drop'; unset = no shadow) and set its params.",
        "properties": {
          "generative": {
            "$refName": "GenerativeShadow",
            "type": "object",
            "description": "Generative AI-shadow params (used when type is 'Generative').",
            "properties": {
              "light_source": {
                "anyOf": [
                  {
                    "$refName": "ShadowLightSource",
                    "unsupported": "depth-exceeded"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Virtual light used to synthesize the shadow. When omitted, the light direction is estimated from the image."
              },
              "opacity": {
                "maximum": 1,
                "minimum": 0,
                "type": "number",
                "default": 0.2,
                "description": "Final composited shadow opacity (0–1)."
              }
            }
          },
          "drop": {
            "$refName": "DropShadow",
            "type": "object",
            "description": "Drop-shadow params (used when type is 'Drop').",
            "properties": {
              "horizontal": {
                "maximum": 100,
                "minimum": -100,
                "type": "number",
                "default": 50,
                "description": "Horizontal shadow offset strength (-100 to 100). Positive moves the shadow right, negative moves it left. 100 is the maximum offset, 10% of the canvas width."
              },
              "opacity": {
                "maximum": 1,
                "minimum": 0,
                "type": "number",
                "default": 0.25,
                "description": "Shadow opacity (0–1)."
              },
              "blur": {
                "maximum": 100,
                "minimum": 0,
                "type": "number",
                "default": 24,
                "description": "Shadow blur strength (0 to 100). 0 is a hard-edged shadow; 100 is the softest, a radius of 5% of the smaller canvas dimension."
              },
              "vertical": {
                "maximum": 100,
                "minimum": -100,
                "type": "number",
                "default": 8,
                "description": "Vertical shadow offset strength (-100 to 100). Positive moves the shadow down, negative moves it up. 100 is the maximum offset, 10% of the canvas height."
              },
              "color": {
                "$refName": "RGBColor",
                "unsupported": "depth-exceeded"
              }
            }
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Generative",
                  "Drop"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Shadow style: 'Generative' (generative AI shadow) or 'Drop' (deterministic drop shadow). Leave unset for no shadow."
          }
        },
        "examples": [
          {
            "type": "Generative"
          }
        ]
      },
