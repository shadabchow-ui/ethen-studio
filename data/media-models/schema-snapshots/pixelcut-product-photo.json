          },
          "image_fit": {
            "examples": [
              "Cover"
            ],
            "type": "string",
            "default": "Cover",
            "description": "How the background image fills the canvas: 'Cover' fills and crops, 'Contain' fits and letterboxes onto `color`, 'Stretch' distorts to fit.",
            "enum": [
              "Cover",
              "Contain",
              "Stretch"
            ]
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Background image URL. Required when mode is 'Image'."
