                "minimum": 0.01,
                "type": "number",
                "default": 0.1,
                "description": "Watermark width as a fraction of the canvas width."
              },
              "margin": {
                "examples": [
                  "3%"
                ],
                "type": "string",
                "default": "3%",
                "description": "Inset from the edge. '%' (0–49%) of the canvas, or 'px'."
              },
              "remove_background": {
                "type": "boolean",
                "default": false,
                "description": "Remove the watermark image's own background (via background removal) before overlaying it."
              }
            }
          },
          {
            "type": "null"
          }
        ],
        "description": "Optional logo/watermark image overlaid on top of the output. Off by default; omit for no watermark."
