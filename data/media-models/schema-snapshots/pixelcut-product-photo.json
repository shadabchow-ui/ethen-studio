                "type": "string",
                "default": "bottom_right",
                "description": "Where to place the watermark.",
                "enum": [
                  "top_left",
                  "top_right",
                  "bottom_left",
                  "bottom_right",
                  "center"
                ]
              },
              "opacity": {
                "maximum": 1,
                "minimum": 0,
                "type": "number",
                "default": 1,
                "description": "Watermark opacity (0–1)."
              },
              "image_url": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Logo/watermark image URL. If empty, no watermark is added."
