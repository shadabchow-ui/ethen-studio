            "type": "object",
            "properties": {
              "g": {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "r": {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "b": {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              }
            },
            "description": "Solid background color (R/G/B, 0–255). Applies when mode is 'Color'. Defaults to white.",
            "default": {
              "g": 255,
              "r": 255,
              "b": 255
            }
          }
        },
        "examples": [
          {
            "mode": "Color",
            "image_fit": "Cover",
            "color": {
              "g": 255,
              "r": 255,
              "b": 255
            }
          }
        ]
      },
      "output_format": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "png",
              "jpeg"
            ]
          },
          {
            "type": "null"
          }
