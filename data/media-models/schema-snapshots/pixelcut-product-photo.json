              "width": {
                "exclusiveMinimum": 0,
                "maximum": 14142,
                "type": "integer",
                "default": 512,
                "description": "The width of the generated image."
              }
            }
          },
          {
            "type": "string",
            "enum": [
              "square_hd",
              "square",
              "portrait_4_3",
              "portrait_16_9",
              "landscape_4_3",
              "landscape_16_9"
            ]
          },
          {
            "type": "null"
          }
        ],
        "default": "square_hd",
        "description": "Output canvas size. A preset (square_hd, square, portrait_4_3, portrait_16_9, landscape_4_3, landscape_16_9) or a custom {width, height}. Defaults to square_hd (1024x1024)."
      },
      "background": {
        "$refName": "Background",
        "type": "object",
        "description": "Output background: solid color (default white), transparent, or an image.",
        "properties": {
          "mode": {
            "type": "string",
            "default": "Color",
            "description": "'Color' fills with `color` (white by default); 'Transparent' leaves it transparent (always PNG); 'Image' composites onto `image_url`.",
            "enum": [
              "Transparent",
              "Color",
              "Image"
