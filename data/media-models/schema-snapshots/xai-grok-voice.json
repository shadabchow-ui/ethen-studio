                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "enabled": {
                "type": "boolean",
                "default": false,
                "description": "Whether to include x_search in session.tools. Disabled by default; set true to let the agent search X posts."
              },
