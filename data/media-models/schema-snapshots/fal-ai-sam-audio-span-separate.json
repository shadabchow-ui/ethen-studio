  "input_name": "SamAudioSpanSeparateInput",
  "input": {
    "$refName": "SamAudioSpanSeparateInput",
    "properties": {
      "prompt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "examples": [
          "man singing",
          "dog barking"
        ],
        "description": "Text prompt describing the sound to isolate. Optional but recommended - helps the model identify what type of sound to extract from the span."
      },
      "spans": {
        "type": "array",
        "items": {
          "$refName": "AudioTimeSpan",
          "properties": {
            "include": {
              "type": "boolean",
              "default": true,
              "description": "Whether to include (True) or exclude (False) sounds in this span"
            },
            "end": {
              "minimum": 0,
              "type": "number",
              "description": "End time of the span in seconds",
              "examples": [
                1.5,
                4
              ]
            },
            "start": {
              "minimum": 0,
              "type": "number",
              "description": "Start time of the span in seconds",
              "examples": [
                0.5,
                2
              ]
            }
          },
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "description": "A time span indicating where the target sound occurs."
        },
        "description": "Time spans where the target sound occurs which should be isolated.",
        "examples": [
          [
            {
              "include": true,
              "end": 10,
              "start": 6
            }
          ]
        ]
      },
      "trim_to_span": {
        "type": "boolean",
        "default": false,
        "description": "Trim output audio to only include the specified span time range. If False, returns the full audio length with the target sound isolated throughout."
      },
      "audio_url": {
        "type": "string",
        "description": "URL of the audio file to process.",
        "examples": [
