  "input_name": "WorkflowUtilitiesPickImageByIndexInput",
  "input": {
    "$refName": "WorkflowUtilitiesPickImageByIndexInput",
    "description": "Input model for selecting a single image from an array by 1-based index.\n\nPass-through utility: the URL is returned as provided in the input,\nwithout fetching or re-uploading the image.",
    "properties": {
      "image_urls": {
        "description": "Array of image URLs to select from",
        "items": {
          "type": "string"
        },
        "type": "array",
        "examples": [
          [
            "https://storage.googleapis.com/falserverless/example_inputs/ltxv-image-input.jpg",
            "https://storage.googleapis.com/falserverless/example_inputs/wan_s2v_cat.png"
          ]
        ]
      },
      "fallback_index": {
        "description": "Behavior when `index` exceeds the length of `image_urls`. When `first-image`, returns the first image in the array. When `last-image`, returns the last image in the array. This input has no effect when `index` is within range, when `index` is below 1, or when `image_urls` is empty (the latter two cases still return validation errors). Default is `first-image`.",
        "enum": [
          "first-image",
          "last-image"
        ],
        "type": "string",
        "default": "first-image"
      },
      "index": {
        "description": "1-based position of the image to return. Value 1 returns the first image, 2 returns the second, and so on.",
        "type": "integer",
        "examples": [
          1
        ]
      }
    },
    "type": "object",
    "required": [
      "image_urls",
      "index"
    ]
  },
