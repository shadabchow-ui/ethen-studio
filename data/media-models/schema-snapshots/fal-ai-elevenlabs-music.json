  "category": "text-to-audio",
  "bytes_sha256": "f202028663231c47a08f2ebb40b29e67d5fd809057b97ca146ad3b04a7d5b704",
  "queue_path": "/fal-ai/elevenlabs/music",
  "input_name": "ElevenlabsMusicInput",
  "input": {
    "$refName": "ElevenlabsMusicInput",
    "type": "object",
    "description": "Request format for Elevenlabs Music API",
    "properties": {
      "prompt": {
        "description": "The text prompt describing the music to generate",
        "anyOf": [
          {
            "type": "string",
            "maxLength": 4100
          },
          {
            "type": "null"
          }
        ]
      },
      "respect_sections_durations": {
        "type": "boolean",
        "default": true,
        "description": "Controls how strictly section durations in the composition_plan are enforced. It will only have an effect if it is used with composition_plan. When set to true, the model will precisely respect each section's duration_ms from the plan. When set to false, the model may adjust individual section durat"
      },
      "composition_plan": {
        "description": "The composition plan for the music",
        "anyOf": [
          {
            "$refName": "MusicCompositionPlan",
            "type": "object",
            "properties": {
              "positive_global_styles": {
                "type": "array",
                "description": "The styles that should be present in the entire song.",
                "items": {
                  "type": "string"
                }
              },
              "sections": {
                "type": "array",
                "description": "The sections of the song.",
                "items": {
                  "$refName": "MusicSection",
                  "type": "object",
                  "properties": {
                    "negative_local_styles": {
                      "type": "array",
                      "description": "The styles that should not be present in this section.",
                      "items": {
                        "unsupported": "depth-exceeded"
                      }
                    },
                    "positive_local_styles": {
                      "type": "array",
                      "description": "The styles that should be present in this section.",
                      "items": {
                        "unsupported": "depth-exceeded"
                      }
                    },
                    "lines": {
                      "type": "array",
                      "description": "The lyrics of the section. Each line must be at most 200 characters long.",
                      "items": {
                        "unsupported": "depth-exceeded"
                      }
                    },
                    "section_name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "description": "The name of the section. Must be between 1 and 100 characters."
                    },
                    "duration_ms": {
                      "type": "integer",
                      "minimum": 3000,
                      "maximum": 120000,
                      "description": "The duration of the section in milliseconds. Must be between 3000ms and 120000ms."
                    }
                  },
                  "required": [
                    "section_name",
                    "positive_local_styles",
                    "negative_local_styles",
                    "duration_ms",
                    "lines"
                  ]
                }
              },
              "negative_global_styles": {
                "type": "array",
                "description": "The styles that should not be present in the entire song.",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "positive_global_styles",
              "negative_global_styles",
              "sections"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "force_instrumental": {
        "type": "boolean",
        "default": false,
        "description": "If true, guarantees that the generated song will be instrumental. If false, the song may or may not be instrumental depending on the prompt. Can only be used with prompt."
      },
      "output_format": {
        "type": "string",
        "enum": [
          "mp3_22050_32",
          "mp3_44100_32",
          "mp3_44100_64",
          "mp3_44100_96",
          "mp3_44100_128",
          "mp3_44100_192",
          "pcm_8000",
          "pcm_16000",
          "pcm_22050",
          "pcm_24000",
          "pcm_44100",
          "pcm_48000",
          "ulaw_8000",
          "alaw_8000",
          "opus_48000_32",
          "opus_48000_64",
          "opus_48000_96",
          "opus_48000_128",
          "opus_48000_192"
        ],
        "default": "mp3_44100_128",
        "description": "Output format of the generated audio. Formatted as codec_sample_rate_bitrate. So an mp3 with 22.05kHz sample rate at 32kbs is represented as mp3_22050_32. MP3 with 192kbps bitrate requires you to be subscribed to Creator tier or above. PCM with 44.1kHz sample rate requires you to be subscribed to Pr"
      },
      "music_length_ms": {
        "description": "The length of the song to generate in milliseconds. Used only in conjunction with prompt. Must be between 3000ms and 600000ms. Optional - if not provided, the model will choose a length based on the prompt.",
        "anyOf": [
          {
            "type": "integer",
            "minimum": 3000,
            "maximum": 600000
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "output_name": "QueueStatus",
  "output": {
    "$refName": "QueueStatus",
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "IN_QUEUE",
          "IN_PROGRESS",
          "COMPLETED"
        ]
      },
      "request_id": {
        "type": "string",
        "description": "The request id."
      },
      "response_url": {
        "type": "string",
        "description": "The response url."
      },
      "status_url": {
        "type": "string",
        "description": "The status url."
      },
      "cancel_url": {
        "type": "string",
        "description": "The cancel url."
      },
      "logs": {
        "type": "object",
        "description": "The logs."
      },
      "metrics": {
        "type": "object",
        "description": "The metrics."
      },
      "queue_position": {
        "type": "integer",
        "description": "The queue position."
      }
    },
    "required": [
      "status",
      "request_id"
    ]
  },
