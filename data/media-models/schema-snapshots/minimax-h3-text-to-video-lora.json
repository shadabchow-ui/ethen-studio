        "type": "string"
      },
      "prompt": {
        "maxLength": 50000,
        "description": "Text prompt for video generation",
        "minLength": 1,
        "type": "string",
        "examples": [
          "A white kitten chases a butterfly across a sunlit garden. Gentle camera tracking, natural movement, soft afternoon light filtering through the leaves."
        ]
      },
