  "input_name": "H3MaxTurboTextToVideoInput",
  "input": {
    "$refName": "H3MaxTurboTextToVideoInput",
    "properties": {
      "prompt": {
        "description": "Text prompt for video generation",
        "type": "string",
        "maxLength": 50000,
        "minLength": 1,
        "examples": [
          "A white kitten chases a butterfly across a sunlit garden. Gentle camera tracking, natural movement, soft afternoon light filtering through the leaves."
        ]
      },
      "aspect_ratio": {
        "type": "string",
        "default": "16:9",
        "enum": [
          "21:9",
          "16:9",
          "4:3",
          "1:1",
          "3:4",
          "9:16"
        ],
        "description": "The aspect ratio of the generated video."
      },
      "target_audio_url": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "\\S",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ],
        "description": "Optional URL of an audio clip at least 2 seconds long (maximum 15 MB) to pin to the generated soundtrack. Longer clips are trimmed to the requested video duration, keeping the beginning. The original audio replaces the output soundtrack, padded with silence if shorter than the video, without changing playback speed. Exceptionally high sample rates may be resampled to 96 kHz. Accepts an HTTP(S) URL or a base64 data URI."
      },
      "resolution": {
        "type": "string",
        "default": "768P",
        "enum": [
          "480P",
          "768P",
          "1080P"
        ],
        "description": "The native generation resolution, or 1080P latent refinement from a native 768P source."
      },
      "enable_safety_checker": {
        "type": "boolean",
        "default": true,
        "description": "If set to true, the safety checker will be enabled."
      },
      "prompt_expansion_mode": {
        "type": "string",
        "default": "balanced",
        "examples": [
          "disabled",
          "balanced",
          "quality"
        ],
        "description": "How much effort to spend rewriting the prompt before generation. 'disabled' skips prompt expansion. 'balanced' returns in about a second. 'quality' spends up to ~30s on a richer prompt."
      },
      "duration": {
        "minimum": 0.92,
        "type": "number",
        "default": 5,
        "maximum": 15,
        "description": "Video length in seconds. The output can run up to about 0.7 s longer than requested. Use at least 2 s with target_audio_url."
      },
      "seed": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "description": "Random seed. A random seed is selected when omitted."
      },
      "sync_mode": {
        "type": "boolean",
        "default": false,
        "description": "Return the generated video as base64 instead of a CDN URL."
      }
    },
    "type": "object",
    "required": [
      "prompt",
      "prompt_expansion_mode"
    ]
  },
