        "type": "string",
        "examples": [
          "https://v3b.fal.media/files/b/0a86b60d/xkpao5B0uxmH0tmJm0HVL_2fe35ce1-fe44-475b-b582-6846a149537c.png"
        ],
        "description": "URL of the reference image for texturing"
      },
