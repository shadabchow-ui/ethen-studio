  "queue_path": "/fal-ai/workflow-utilities/scale-video",
  "input_name": "WorkflowUtilitiesScaleVideoInput",
  "input": {
    "$refName": "WorkflowUtilitiesScaleVideoInput",
    "description": "Input model for scaling/resizing a video to specific dimensions",
    "properties": {
      "width": {
        "description": "Target width in pixels. If only width is provided, height is auto-calculated to preserve aspect ratio. At least one of width or height must be provided.",
        "anyOf": [
          {
            "maximum": 7680,
            "type": "integer",
            "minimum": 2
          },
          {
            "type": "null"
          }
        ],
        "examples": [
          1920,
          3840,
          1280
        ]
      },
      "pad_color": {
        "description": "Padding color when mode is 'pad'. Ignored for other modes.",
        "enum": [
          "black",
          "white",
          "red",
          "green",
          "blue",
          "gray"
        ],
        "type": "string",
        "default": "black"
      },
      "video_url": {
        "description": "URL of the video file to scale/resize. Height and Width of the video must be even numbers for compatibility with video codecs.",
        "type": "string",
        "examples": [
          "https://storage.googleapis.com/falserverless/example_outputs/wan-25-i2v-output.mp4"
        ],
        "max_file_size": 500000000
      },
      "height": {
        "description": "Target height in pixels. If only height is provided, width is auto-calculated to preserve aspect ratio. At least one of width or height must be provided.",
        "anyOf": [
          {
            "maximum": 4320,
            "type": "integer",
            "minimum": 2
          },
          {
            "type": "null"
          }
        ],
        "examples": [
          1080,
          2160,
          720
        ]
      },
      "mode": {
        "description": "Scaling mode. 'stretch' scales the video to the exact target dimensions (may distort aspect ratio). 'pad' scales to fit within the target dimensions while preserving aspect ratio, then pads with the chosen color to fill the remaining space (letterbox/pillarbox). 'crop' scales to cover the target dimensions while preserving aspect ratio, then center-crops to the exact target size.",
        "enum": [
          "stretch",
          "pad",
          "crop"
        ],
        "type": "string",
        "default": "stretch"
      },
      "preset": {
        "description": "Encoding speed preset. Slower presets give better compression but take longer.",
        "enum": [
          "ultrafast",
          "fast",
          "medium",
          "slow"
        ],
        "type": "string",
        "default": "fast"
      },
      "codec": {
        "description": "Video codec to use for encoding. libx264 (H.264) is widely compatible, libx265 (H.265/HEVC) offers better compression.",
        "enum": [
          "libx264",
          "libx265"
        ],
        "type": "string",
        "default": "libx264"
      },
      "crf": {
        "maximum": 51,
        "description": "Constant Rate Factor for quality (0-51). Lower values mean better quality and larger files. 18 is visually lossless for most content.",
        "type": "integer",
        "minimum": 0,
        "default": 18
      }
    },
    "type": "object",
    "required": [
      "video_url"
    ]
  },
